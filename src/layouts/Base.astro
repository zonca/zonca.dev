---
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import SocialIcons from '../components/SocialIcons.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const pageTitle = title ? `${title} - Andrea Zonca` : 'Andrea Zonca';
const metaDescription =
  description ?? 'Notes on Python, JupyterHub, Kubernetes and AI for science from the San Diego Supercomputer Center.';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '/index.html' || path.startsWith('/page/') : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    {
      canonical && <link rel="canonical" href={new URL(canonical, Astro.site).href} />
    }
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Andrea Zonca" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a class="brand" href="/">Andrea Zonca</a>
        <div class="nav-right">
          <a class="nav-link" href="/about.html" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a class="nav-link" href="/ai/index.html" aria-current={isActive('/ai') ? 'page' : undefined}>
            AI Consulting
          </a>
          <div class="nav-social">
            <SocialIcons />
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© Andrea Zonca · San Diego Supercomputer Center, UC San Diego</span>
        <span class="footer-built">Built with Astro</span>
      </div>
    </footer>
  </body>
</html>
