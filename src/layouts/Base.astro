---
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import SocialIcons from '../components/SocialIcons.astro';
import { search } from '../components/icons.mjs';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Keep the page out of the index (client side UIs with no content of their own). */
  noindex?: boolean;
}

const { title, description, canonical, noindex } = Astro.props;
const pageTitle = title ? `${title} - Andrea Zonca` : 'Andrea Zonca';
const metaDescription =
  description ?? 'Notes on Python, JupyterHub, Kubernetes and AI for science from the San Diego Supercomputer Center.';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '/index.html' || path.startsWith('/page/') : path.startsWith(href);

// Site level structured data. Deliberately WebSite + Person only: Google's
// Article/BlogPosting rich result also requires a per post image, which this
// site does not have, so emitting BlogPosting would create an enhancement
// report in Search Console without producing any enriched result. The
// SearchAction target must stay in step with src/pages/search.astro.
const siteUrl = (Astro.site?.href ?? 'https://www.zonca.dev/').replace(/\/$/, '');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Andrea Zonca',
      inLanguage: 'en',
      author: { '@id': `${siteUrl}/#person` },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/search?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Andrea Zonca',
      url: `${siteUrl}/about`,
      jobTitle: 'Computational Scientist',
      worksFor: {
        '@type': 'Organization',
        name: 'San Diego Supercomputer Center, UC San Diego',
        url: 'https://www.sdsc.edu/',
      },
      sameAs: [
        'https://github.com/zonca',
        'https://mastodon.online/@zonca',
        'https://twitter.com/andreazonca',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b4f6c" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    {
      canonical && <link rel="canonical" href={new URL(canonical, Astro.site).href} />
    }
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Andrea Zonca" href="/rss.xml" />
  </head>
  <body id="top">
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a class="brand" href="/">Andrea Zonca</a>
        <div class="nav-right">
          <a class="nav-link" href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a class="nav-link" href="/ai/" aria-current={isActive('/ai') ? 'page' : undefined}>
            AI Consulting
          </a>
          <div class="nav-social">
            <a class="nav-icon-link" href="/search" aria-label="Search" title="Search">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d={search} />
              </svg>
            </a>
            <SocialIcons />
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>
          © Andrea Zonca · San Diego Supercomputer Center, UC San Diego · Content
          <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener">
            CC BY 4.0
          </a>
        </span>
        <span class="footer-right">
          <span class="footer-built">Built with Astro</span>
          <a class="footer-top" href="#top">↑ Top</a>
        </span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        if (!header || typeof ResizeObserver === 'undefined') return;
        const set = () =>
          document.documentElement.style.setProperty('--site-header-h', `${header.offsetHeight}px`);
        set();
        new ResizeObserver(set).observe(header);
      })();
    </script>
  </body>
</html>
