---
import Base from '../layouts/Base.astro';
import { getAllPosts, PAGE_SIZE } from '../lib/posts';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';

const posts = await getAllPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<Base title="Andrea Zonca - Scientific computing and astronomy">
  <a style="display:none" rel="me" href="https://mastodon.online/@zonca">Mastodon</a>
  <div class="home">
    <section class="home-hero">
      <h1 class="home-title">Scientific computing &amp; astronomy</h1>
      <p class="home-subtitle">
        Distributed data processing in Python for cosmology and astronomy. JupyterHub, Kubernetes,
        and AI in science.
      </p>
    </section>
    <PostList posts={pagePosts} />
    {
      totalPages > 1 && <Pagination current={1} total={totalPages} />
    }
  </div>
</Base>
