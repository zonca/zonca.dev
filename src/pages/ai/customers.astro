---
import Base from '../../layouts/Base.astro';
import AiSubnav from '../../components/AiSubnav.astro';
import AiDisclaimer from '../../components/AiDisclaimer.astro';

const description =
  'Websites, payment systems, inquiries, email drafts, outreach, and historical contact research for small businesses.';
---

<Base title="AI for websites and customer communication" description={description} canonical="/ai/customers.html">
  <div class="ai-page">
    <div class="ai-subhero">
      <p class="ai-kicker">Customer systems</p>
      <h1 class="post-title">Make it easier for customers to get an answer</h1>
      <p>
        Connect the website, forms, payments, email, and internal records so routine inquiries move
        faster and unusual cases receive focused human attention.
      </p>
    </div>
    <AiSubnav />
    <section class="ai-section">
      <h2>Customer-facing work that can be improved</h2>
      <div class="ai-grid">
        <div class="ai-card">
          <h3>Websites and forms</h3>
          <p>Build clear pages and structured forms that collect the information needed for the next step.</p>
        </div>
        <div class="ai-card">
          <h3>Payment systems</h3>
          <p>
            Connect payment status with the correct service, customer record, receipt, and follow-up
            workflow.
          </p>
        </div>
        <div class="ai-card">
          <h3>Inquiries and email drafts</h3>
          <p>
            Research the relevant record, prepare a direct response, and place the complete draft in
            front of a responsible person for approval.
          </p>
        </div>
        <div class="ai-card">
          <h3>Outreach and contact research</h3>
          <p>
            Find relevant historical contacts, organize prior interactions, and prepare focused
            outreach without sending it automatically.
          </p>
        </div>
      </div>
      <div class="ai-policy">
        <p>
          Customer communication always has an accountable owner. Drafting and research may be
          automatic, but sending and changing customer records require approval.
        </p>
      </div>
      <div class="ai-actions">
        <a class="ai-button" href="https://zonca.secureform.dev/contact">Discuss a customer workflow</a>
      </div>
    </section>
    <AiDisclaimer />
  </div>
</Base>
