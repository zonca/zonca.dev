---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const pages = await getCollection('pages', ({ id }) => id === 'SKILL');
const page = pages[0];
const { Content } = await render(page);
---

<Base title="skill/SKILL.md" canonical="/skill/SKILL.html">
  <article class="prose">
    <Content />
  </article>
</Base>
