---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';

export interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a class="post-link" href={`/posts/${post.id}.html`}>
          <h2 class="post-item-title">{post.title}</h2>
          {
            post.date && (
              <time class="post-item-date" datetime={formatDate(post.date)}>
                {formatDate(post.date)}
              </time>
            )
          }
        </a>
        {
          post.categories.length > 0 && (
            <ul class="post-item-cats" aria-label="Categories">
              {post.categories.map((cat) => (
                <li>{cat}</li>
              ))}
            </ul>
          )
        }
      </li>
    ))
  }
</ul>
