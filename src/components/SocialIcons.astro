---
import { github, mastodon, x } from './icons.mjs';

export interface Props {
  iconClass?: string;
}
const { iconClass = 'nav-icon' } = Astro.props;

const socials = [
  { id: 'github', path: github, label: 'GitHub', href: 'https://github.com/zonca' },
  { id: 'mastodon', path: mastodon, label: 'Mastodon', href: 'https://mastodon.online/@zonca' },
  { id: 'x', path: x, label: 'X (Twitter)', href: 'https://twitter.com/andreazonca' },
];
---

<ul class="socials">
  {
    socials.map((s) => (
      <li>
        <a class={iconClass} href={s.href} aria-label={s.label} title={s.label}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
